{
  "name": "cs2-casual-enjoyer",
  "version": "0.9.7",
  "description": "Joins a friend's CS2 Casual match the moment a slot frees up, and finds official casual servers by map",
  "keywords": [
    "cs2",
    "counter-strike-2",
    "counter-strike",
    "steam",
    "casual",
    "auto-join",
    "electron",
    "windows"
  ],
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron . --remote-debugging-port=9222",
    "dev": "electron . --inspect=9223 --remote-debugging-port=9222",
    "build": "electron-builder",
    "dist": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "cs2casualenjoyer",
    "productName": "Casual-Enjoyer",
    "artifactName": "${productName}.${ext}",
    "files": [
      "src/**/*",
      "index.html",
      "css/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Casual Enjoyer",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "include": "installer/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "icon": "assets/icon.ico",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "compression": "maximum",
    "publish": {
      "provider": "github",
      "owner": "skik4",
      "repo": "cs2-casual-enjoyer",
      "releaseType": "release"
    }
  },
  "author": "skik4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skik4/cs2-casual-enjoyer.git"
  },
  "homepage": "https://github.com/skik4/cs2-casual-enjoyer#readme",
  "bugs": {
    "url": "https://github.com/skik4/cs2-casual-enjoyer/issues"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.28.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
